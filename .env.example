# Copy to ~/.config/supernote-agent/.env (chmod 600). Never commit the real file.
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_HOME_CHANNEL=channel-id-where-the-bot-posts
# Comma-separated Discord user IDs allowed to steer notes by replying
DISCORD_ALLOWED_USERS=your-user-id

# Optional overrides
# SUPERNOTE_VAULT=~/Documents/Obsidian Vault
# OLLAMA_URL=http://localhost:11434
# SUPERNOTE_VISION_MODEL=qwen2.5vl:7b
# SUPERNOTE_RECOGN_TIMEOUT=90
# HERMES_BIN=~/.local/bin/hermes
